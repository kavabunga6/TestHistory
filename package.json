{
  "name": "testhistory",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Test intelligence platform compatible with the allure-results data format",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @testhistory/contracts && npm run build -w @testhistory/artifacts && npm run build -w @testhistory/allure-parser && npm run build -w @testhistory/domain && npm run build -w @testhistory/api && npm run build -w @testhistory/worker && npm run build -w @testhistory/mcp && npm run build -w @testhistory/web",
    "check": "npm run build && npm run guard:module-size && npm run guard:frontend-perf && npm run test",
    "screenshots:capture": "npm run build -w @testhistory/web && node scripts/capture-ui-screenshots.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "licenses:check": "node scripts/check-dependency-licenses.mjs",
    "dev": "npm run dev -w @testhistory/api",
    "docker:check": "docker compose --profile checks run --rm checks",
    "docker:check:web": "docker compose --profile checks run --rm checks npm run test -w @testhistory/web",
    "docker:down": "node scripts/local-stack.mjs down",
    "docker:doctor": "node scripts/local-stack.mjs doctor",
    "docker:help": "node scripts/local-stack.mjs help",
    "docker:migrate": "node scripts/local-stack.mjs migrate",
    "docker:reset": "node scripts/local-stack.mjs reset",
    "docker:smoke": "node scripts/local-stack.mjs smoke",
    "docker:status": "node scripts/local-stack.mjs status",
    "docker:up": "node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "local:doctor": "node scripts/local-stack.mjs doctor",
    "local:check-ui": "node scripts/smoke-local-ui.mjs",
    "local:demo": "node scripts/local-dev.mjs --seed-evidence",
    "local:dev": "node scripts/local-dev.mjs",
    "local:dev:stop": "node scripts/local-dev.mjs --stop",
    "local:help": "node scripts/local-stack.mjs help",
    "local:logs": "node scripts/local-stack.mjs logs",
    "local:migrate": "node scripts/local-stack.mjs migrate",
    "local:prune-smoke": "node scripts/prune-local-smoke-data.mjs",
    "local:restart": "node scripts/local-stack.mjs restart",
    "local:reset": "node scripts/local-stack.mjs reset",
    "local:smoke": "node scripts/local-stack.mjs smoke",
    "local:status": "node scripts/local-stack.mjs status",
    "local:up": "node scripts/local-stack.mjs up",
    "format": "prettier --check \"*.{json,md,js,yml,yaml}\" \".prettierrc\" \"{.github,apps,docs,infra,packages,scripts}/**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:write": "prettier --write \"*.{json,md,js,yml,yaml}\" \".prettierrc\" \"{.github,apps,docs,infra,packages,scripts}/**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "guard:button-overflow": "npm run build -w @testhistory/web && node scripts/guard-button-overflow.mjs",
    "guard:frontend-perf": "node scripts/guard-frontend-performance-contract.mjs",
    "guard:module-size": "node scripts/guard-module-size.mjs",
    "guard:ui-design": "node scripts/guard-ui-design-contract.mjs",
    "guard:ui-interactions": "npm run build -w @testhistory/web && node scripts/guard-ui-interactions.mjs",
    "api:docs:catalog": "node scripts/update-api-docs-catalog.mjs",
    "openapi:check": "npm run build -w @testhistory/contracts && npm run build -w @testhistory/artifacts && npm run build -w @testhistory/allure-parser && npm run build -w @testhistory/domain && npm run build -w @testhistory/api && node scripts/guard-openapi-valid.mjs && node scripts/guard-openapi-parity.mjs",
    "guard:sensitive": "node scripts/guard-sensitive-artifacts.mjs",
    "k8s:deploy": "node scripts/k8s.mjs deploy",
    "k8s:deploy:local": "node scripts/k8s.mjs deploy --path infra/k8s/overlays/local",
    "k8s:deploy:prod": "node scripts/k8s.mjs deploy --path infra/k8s/overlays/prod",
    "k8s:help": "node scripts/k8s.mjs help",
    "k8s:logs": "node scripts/k8s.mjs logs",
    "k8s:migrate": "node scripts/k8s.mjs migrate",
    "k8s:migrate:local": "node scripts/k8s.mjs migrate --path infra/k8s/overlays/local",
    "k8s:migrate:prod": "node scripts/k8s.mjs migrate --path infra/k8s/overlays/prod",
    "k8s:smoke": "node scripts/k8s.mjs smoke",
    "k8s:status": "node scripts/k8s.mjs status",
    "k8s:undeploy": "node scripts/k8s.mjs undeploy",
    "k8s:undeploy:local": "node scripts/k8s.mjs undeploy --path infra/k8s/overlays/local",
    "k8s:undeploy:prod": "node scripts/k8s.mjs undeploy --path infra/k8s/overlays/prod",
    "k8s:validate": "node scripts/k8s.mjs validate",
    "k8s:validate:all": "node scripts/k8s.mjs validate-all",
    "k8s:validate:local": "node scripts/k8s.mjs validate --path infra/k8s/overlays/local",
    "k8s:validate:prod": "node scripts/k8s.mjs validate --path infra/k8s/overlays/prod",
    "lint": "eslint . --max-warnings 0",
    "load:soak": "npm run build -w @testhistory/contracts && npm run build -w @testhistory/artifacts && npm run build -w @testhistory/allure-parser && npm run build -w @testhistory/domain && npm run build -w @testhistory/api && node scripts/load-soak-ingestion-evidence.mjs",
    "perf:fixture": "node scripts/generate-enterprise-allure-fixture.mjs",
    "production:evidence:check": "node scripts/verify-production-readiness-evidence.mjs",
    "production:evidence:test": "node --test scripts/verify-production-readiness-evidence.test.mjs",
    "release:evidence:check": "node scripts/guard-release-evidence.mjs",
    "rehydrate:local:artifacts": "npm run build -w @testhistory/api && node scripts/rehydrate-local-artifact-objects.mjs",
    "seed:allure": "node scripts/seed-synthetic-allure-results.mjs",
    "seed:local:evidence": "node scripts/import-local-allure-evidence.mjs",
    "seed:local:metadata": "node scripts/seed-local-test-case-metadata.mjs",
    "seed:local:nested-steps": "node scripts/seed-local-nested-steps.mjs",
    "seed:history": "node scripts/seed-history-allure-results.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:ui:local": "node scripts/smoke-local-ui.mjs",
    "smoke:perf": "node scripts/smoke-enterprise-performance.mjs && node scripts/guard-frontend-performance-contract.mjs",
    "smoke:quality-gate": "npm run build -w @testhistory/contracts && npm run build -w @testhistory/domain && node scripts/smoke-quality-gate.mjs",
    "smoke:k8s": "node scripts/smoke-api.mjs --k8s-readiness",
    "smoke:upload-close-ui": "node scripts/smoke-upload-close-ui.mjs",
    "test": "npm run guard:sensitive && npm run licenses:check && npm run production:evidence:test && npm run test -w @testhistory/allure-parser && npm run test -w @testhistory/artifacts && npm run test -w @testhistory/domain && npm run test -w @testhistory/api && npm run test -w @testhistory/worker && npm run test -w @testhistory/mcp && npm run test -w @testhistory/web",
    "typecheck": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
