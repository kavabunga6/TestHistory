NODE_ENV=development
API_PORT=18080
WEB_PORT=5173
TESTHISTORY_STORE_FILE=.testhistory/local-store.json
# Docker Compose binds public entrypoints to localhost by default. Set to
# 0.0.0.0 only when another machine/container, such as a GitLab runner, must
# reach TestHistory through the host IP.
TESTHISTORY_HOST_BIND=127.0.0.1
# Local Docker Desktop defaults. For shared or deployed environments, keep
# credentials in an untracked .env file or secret manager, not in Git.
DATABASE_URL=postgres://testhistory:testhistory@localhost:5432/testhistory
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://testhistory:testhistory@localhost:5672/testhistory
# Dependency endpoints are private/local service endpoints, not public
# end-user URLs. Use private DNS, VPC endpoints, or cluster services outside
# local development.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=testhistory-artifacts
S3_REGION=us-east-1
# MinIO and most local S3-compatible services require path-style addressing.
S3_FORCE_PATH_STYLE=true
# Optional namespace inside the bucket. Keep credentials in an untracked env
# file or secret manager; the AWS SDK default credential chain is used when
# explicit credentials are omitted.
S3_PREFIX=testhistory
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
CLICKHOUSE_URL=http://localhost:8123
OPENSEARCH_URL=http://localhost:9200
TESTHISTORY_API_URL=http://localhost:18080
# Shared only between the API and worker. Replace it outside local development.
TESTHISTORY_WORKER_TOKEN=local-worker-token-change-me
# Exact comma-separated hostnames allowed for outbound integrations when they
# resolve to private/local infrastructure (for example an internal Jira).
TESTHISTORY_OUTBOUND_HOST_ALLOWLIST=
# At least 32 random characters. Encrypts inbound webhook secrets that must be
# recoverable for provider-native HMAC verification (for example GitHub).
TESTHISTORY_INTEGRATION_MASTER_KEY=
# Integration credentials and webhook signing secrets are referenced by their
# environment-variable names in project settings; their values stay here or in
# the deployment secret manager and are never persisted in TestHistory.
TESTHISTORY_EXAMPLE_ISSUE_TOKEN=
TESTHISTORY_EXAMPLE_WEBHOOK_SECRET=
# OIDC providers store only this variable name in project settings. Supply the
# actual client secret through an untracked environment or secret manager.
TESTHISTORY_OIDC_CLIENT_SECRET=
# Required for the first production/Compose login on a fresh store. Use an
# untracked .env file or secret manager and at least 12 password characters.
TESTHISTORY_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
TESTHISTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Production registration is disabled unless explicitly enabled.
TESTHISTORY_ALLOW_REGISTRATION=false
WORKER_HEARTBEAT_MS=30000
WORKER_INTEGRATION_DELIVERY_INTERVAL_MS=5000
WORKER_INTEGRATION_DELIVERY_LIMIT=25
UPLOAD_MAX_CONCURRENCY=8
UPLOAD_CHUNK_BYTES=8388608
ARTIFACT_RETENTION_DAYS=90
ARTIFACT_COMPRESSION_MIN_BYTES=1024
ARTIFACT_MAX_BYTES=536870912
UPLOAD_SESSION_MAX_BYTES=1073741824
UPLOAD_MAX_CHUNKS=10000
UPLOAD_SESSION_TTL_MINUTES=60
ARTIFACT_CLEANUP_GRACE_DAYS=7
ARTIFACT_CLEANUP_BATCH_SIZE=1000
ARTIFACT_CLEANUP_BATCH_INTERVAL_MINUTES=5
UPLOAD_METADATA_SOURCE=result
